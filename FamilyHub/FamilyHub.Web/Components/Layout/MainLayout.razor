                        Start
                    </NavLink>
                </li>

                <li class="nav-item">
                    <NavLink class="nav-link"
                             href="/meals">
                        Gerichte
                    </NavLink>
                </li>

                <li class="nav-item">
                    <NavLink class="nav-link"
                             href="/mealplans">
                        Wochenplan
                    </NavLink>
                </li>

                <li class="nav-item">
                    <NavLink class="nav-link"
                             href="/shopping">
