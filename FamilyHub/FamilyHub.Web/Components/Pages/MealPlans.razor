@page "/mealplans"
@rendermode InteractiveServer

@using System.Globalization
@using System.Net
@using System.Net.Http.Json
@inject IHttpClientFactory HttpClientFactory

<h2>Wochenplan</h2>

<div class="row g-3 align-items-end mb-4">
    <div class="col-auto">
        <label class="form-label">Jahr</label>
        <input class="form-control"
               type="number"
               @bind="year" />
    </div>

    <div class="col-auto">
        <label class="form-label">Kalenderwoche</label>
        <input class="form-control"
               type="number"
               min="1"
               max="53"
               @bind="calendarWeek" />
    </div>

    <div class="col-auto">
        <button class="btn btn-primary"
                @onclick="LoadPlan">
            Wochenplan laden
        </button>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">
        @errorMessage
    </div>
}

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="alert alert-success">
        @successMessage
    </div>
}

@if (loading)
{
    <p>Wochenplan wird geladen...</p>
}
else if (plan is null)
{
    <div class="alert alert-info">
        Für KW @calendarWeek / @year existiert noch kein Wochenplan.
    </div>

    <button class="btn btn-success"
            @onclick="CreatePlan">
        Wochenplan anlegen
    </button>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0">
            KW @plan.CalendarWeek / @plan.Year
        </h4>

        <button class="btn btn-success"
                disabled="@saving"
                @onclick="SaveWeek">
            @if (saving)
            {
                <span>Speichere...</span>
            }
            else
            {
                <span>Woche speichern</span>
            }
        </button>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered align-middle">
            <thead>
                <tr>
                    <th style="width: 200px;">Tag</th>
                    <th>Gericht und Beilagen</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var day in days)
                {
                    <tr>
                        <td class="align-top">
                            <strong>@GetDayName(day.Date)</strong>

                            <br />

                            <small class="text-muted">
                                @day.Date.ToString("dd.MM.yyyy")
                            </small>
                        </td>

                        <td>
                            <select class="form-select"
                                    @bind="day.SelectedMealId"
                                    @bind:after="() => MealChanged(day)">

                                <option value="">
                                    -- kein Gericht --
                                </option>

                                @foreach (var meal in meals.OrderBy(x => x.Name))
                                {
                                    <option value="@meal.Id">
                                        @meal.Name
                                    </option>
                                }

                            </select>

                            @if (!string.IsNullOrWhiteSpace(day.SelectedMealId))
                            {
                                <div class="mt-3 border-top pt-3">

                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <strong>Beilagen</strong>

                                        <button class="btn btn-outline-secondary btn-sm"
                                                type="button"
                                                @onclick="() => ToggleSideDishes(day)">
                                            @(day.ShowSideDishes
                                                ? "Beilagen schließen"
                                                : "Beilagen bearbeiten")
                                        </button>
                                    </div>

                                    @if (day.SelectedSideDishIds.Count > 0)
                                    {
                                        <div class="mb-2">
                                            @foreach (var sideDish in GetSelectedSideDishes(day))
                                            {
                                                <span class="badge text-bg-secondary me-1 mb-1">
                                                    @sideDish.Name
                                                </span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-muted small mb-2">
                                            Keine Beilagen ausgewählt.
                                        </div>
                                    }

                                    @if (day.ShowSideDishes)
                                    {
                                        <div class="border rounded p-3">

                                            @{
                                                var availableSideDishes =
                                                    GetAvailableSideDishes(day);
                                            }

                                            @if (availableSideDishes.Count > 0)
                                            {
                                                <div class="input-group mb-3">

                                                    <select class="form-select"
                                                            @bind="day.SideDishToAddId">

                                                        <option value="">
                                                            Vorhandene Beilage auswählen...
                                                        </option>

                                                        @foreach (var sideDish in availableSideDishes)
                                                        {
                                                            <option value="@sideDish.Id">
                                                                @sideDish.Name
                                                            </option>
                                                        }

                                                    </select>

                                                    <button class="btn btn-outline-primary"
                                                            type="button"
                                                            disabled="@(day.SideDishToAddId is null)"
                                                            @onclick="() => AddExistingSideDish(day)">
                                                        Hinzufügen
                                                    </button>

                                                </div>
                                            }

                                            @if (day.SelectedSideDishIds.Count > 0)
                                            {
                                                <div class="mb-3">

                                                    @foreach (var sideDish in GetSelectedSideDishes(day))
                                                    {
                                                        <div class="d-flex justify-content-between
                                                            align-items-center
                                                            border rounded
                                                            p-2 mb-2">

                                                            <span>
                                                                @sideDish.Name
                                                            </span>

                                                            <button class="btn btn-outline-danger btn-sm"
                                                                    type="button"
                                                                    @onclick="() => RemoveSideDish(day, sideDish.Id)">
                                                                Entfernen
                                                            </button>

                                                        </div>
                                                    }

                                                </div>
                                            }

                                            <div class="input-group">

                                                <input class="form-control"
                                                       @bind="day.NewSideDishName"
                                                       placeholder="Neue Beilage, z.B. Reis" />

                                                <button class="btn btn-outline-primary"
                                                        type="button"
                                                        @onclick="() => CreateSideDish(day)">
                                                    Neu anlegen
                                                </button>

                                            </div>

                                        </div>
                                    }

                                </div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-end mt-3">
        <button class="btn btn-success"
                disabled="@saving"
                @onclick="SaveWeek">
            @if (saving)
            {
                <span>Speichere...</span>
            }
            else
            {
                <span>Woche speichern</span>
            }
        </button>
    </div>
}

@code
{
    private int year;
    private int calendarWeek;

    private bool loading;
    private bool saving;

    private string? errorMessage;
    private string? successMessage;

    private WeeklyMealPlanDto? plan;

    private List<MealDto> meals = new();

    private List<SideDishDto> sideDishes = new();

    private List<DayViewModel> days = new();


    protected override async Task OnInitializedAsync()
    {
        var today = DateTime.Today;

        year = ISOWeek.GetYear(today);
        calendarWeek = ISOWeek.GetWeekOfYear(today);

        await LoadMeals();
        await LoadSideDishes();
        await LoadPlan();
    }


    private HttpClient CreateClient()
    {
        return HttpClientFactory.CreateClient("FamilyHubApi");
    }


    // ---------------------------------------------------------
    // Meals
    // ---------------------------------------------------------

    private async Task LoadMeals()
    {
        try
        {
            var client = CreateClient();

            meals =
                await client.GetFromJsonAsync<List<MealDto>>(
                    "/api/meals")
                ?? new List<MealDto>();
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Gerichte konnten nicht geladen werden: {ex.Message}";
        }
    }


    // ---------------------------------------------------------
    // Side Dishes
    // ---------------------------------------------------------

    private async Task LoadSideDishes()
    {
        try
        {
            var client = CreateClient();

            sideDishes =
                await client.GetFromJsonAsync<List<SideDishDto>>(
                    "/api/sidedishes")
                ?? new List<SideDishDto>();
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Beilagen konnten nicht geladen werden: {ex.Message}";
        }
    }


    private void ToggleSideDishes(DayViewModel day)
    {
        day.ShowSideDishes = !day.ShowSideDishes;

        if (!day.ShowSideDishes)
        {
            day.SideDishToAddId = null;
            day.NewSideDishName = string.Empty;
        }
    }


    private List<SideDishDto> GetSelectedSideDishes(
        DayViewModel day)
    {
        return sideDishes
            .Where(x =>
                day.SelectedSideDishIds.Contains(x.Id))
            .OrderBy(x => x.Name)
            .ToList();
    }


    private List<SideDishDto> GetAvailableSideDishes(
        DayViewModel day)
    {
        return sideDishes
            .Where(x =>
                !day.SelectedSideDishIds.Contains(x.Id))
            .OrderBy(x => x.Name)
            .ToList();
    }


    private void AddExistingSideDish(
        DayViewModel day)
    {
        if (day.SideDishToAddId is null)
        {
            return;
        }

        day.SelectedSideDishIds.Add(
            day.SideDishToAddId.Value);

        day.SideDishToAddId = null;
    }


    private void RemoveSideDish(
        DayViewModel day,
        Guid sideDishId)
    {
        day.SelectedSideDishIds.Remove(
            sideDishId);
    }


    private async Task CreateSideDish(
        DayViewModel day)
    {
        if (string.IsNullOrWhiteSpace(
                day.NewSideDishName))
        {
            return;
        }

        errorMessage = null;

        try
        {
            var client = CreateClient();

            var response =
                await client.PostAsJsonAsync(
                    "/api/sidedishes",
                    new
                    {
                        name = day.NewSideDishName
                    });

            if (!response.IsSuccessStatusCode)
            {
                errorMessage =
                    await ReadErrorMessage(
                        response,
                        "Die Beilage konnte nicht angelegt werden.");

                return;
            }

            var createdSideDish =
                await response.Content
                    .ReadFromJsonAsync<SideDishDto>();

            day.NewSideDishName =
                string.Empty;

            await LoadSideDishes();

            if (createdSideDish is not null)
            {
                day.SelectedSideDishIds.Add(
                    createdSideDish.Id);
            }
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Die Beilage konnte nicht angelegt werden: {ex.Message}";
        }
    }


    private void MealChanged(
        DayViewModel day)
    {
        // Wenn das Gericht entfernt wird,
        // können auch keine Beilagen mehr dazugehören.
        if (string.IsNullOrWhiteSpace(
                day.SelectedMealId))
        {
            day.SelectedSideDishIds.Clear();

            day.SideDishToAddId = null;

            day.NewSideDishName =
                string.Empty;

            day.ShowSideDishes = false;
        }
    }


    // ---------------------------------------------------------
    // Meal Plan
    // ---------------------------------------------------------

    private async Task LoadPlan()
    {
        loading = true;

        errorMessage = null;
        successMessage = null;

        try
        {
            var client = CreateClient();

            var response =
                await client.GetAsync(
                    $"/api/mealplans/{year}/{calendarWeek}");

            if (response.StatusCode ==
                HttpStatusCode.NotFound)
            {
                plan = null;

                BuildDays();

                return;
            }

            response.EnsureSuccessStatusCode();

            plan =
                await response.Content
                    .ReadFromJsonAsync<WeeklyMealPlanDto>();

            BuildDays();
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Wochenplan konnte nicht geladen werden: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }


    private async Task CreatePlan()
    {
        errorMessage = null;
        successMessage = null;

        try
        {
            var client = CreateClient();

            var response =
                await client.PostAsJsonAsync(
                    "/api/mealplans",
                    new
                    {
                        Year = year,
                        CalendarWeek = calendarWeek
                    });

            if (!response.IsSuccessStatusCode)
            {
                errorMessage =
                    await ReadErrorMessage(
                        response,
                        "Der Wochenplan konnte nicht angelegt werden.");

                return;
            }

            await LoadPlan();

            successMessage =
                $"KW {calendarWeek} / {year} wurde angelegt.";
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }


    private void BuildDays()
    {
        days.Clear();

        var monday =
            ISOWeek.ToDateTime(
                year,
                calendarWeek,
                DayOfWeek.Monday);

        for (var i = 0; i < 7; i++)
        {
            var date =
                DateOnly.FromDateTime(
                    monday.AddDays(i));

            var entry =
                plan?.Entries
                    .SingleOrDefault(x =>
                        x.Date == date);

            days.Add(
                new DayViewModel
                {
                    Date = date,

                    SelectedMealId =
                        entry?.MealId.ToString()
                        ?? string.Empty,

                    SelectedSideDishIds =
                        entry?.SideDishes?
                            .Select(x => x.Id)
                            .ToHashSet()
                        ?? new HashSet<Guid>()
                });
        }
    }


    private async Task SaveWeek()
    {
        saving = true;

        errorMessage = null;
        successMessage = null;

        try
        {
            var client = CreateClient();

            // -------------------------------------------------
            // 1. Gerichte der Woche speichern
            // -------------------------------------------------

            var entries =
                days.Select(day =>
                {
                    Guid? mealId = null;

                    if (Guid.TryParse(
                            day.SelectedMealId,
                            out var parsedMealId))
                    {
                        mealId = parsedMealId;
                    }

                    return new SaveWeekEntryRequest
                    {
                        Date = day.Date,
                        MealId = mealId
                    };
                })
                .ToList();

            var request =
                new SaveWeekRequest
                {
                    Entries = entries
                };

            var response =
                await client.PutAsJsonAsync(
                    $"/api/mealplans/{year}/{calendarWeek}",
                    request);

            if (!response.IsSuccessStatusCode)
            {
                errorMessage =
                    await ReadErrorMessage(
                        response,
                        "Die Woche konnte nicht gespeichert werden.");

                return;
            }

            // -------------------------------------------------
            // 2. Beilagen für jeden belegten Tag speichern
            // -------------------------------------------------

            foreach (var day in days)
            {
                if (string.IsNullOrWhiteSpace(
                        day.SelectedMealId))
                {
                    continue;
                }

                var sideDishResponse =
                    await client.PutAsJsonAsync(
                        $"/api/mealplans/{year}/{calendarWeek}/entries/{day.Date:yyyy-MM-dd}/sidedishes",
                        new
                        {
                            sideDishIds =
                                day.SelectedSideDishIds.ToList()
                        });

                if (!sideDishResponse.IsSuccessStatusCode)
                {
                    errorMessage =
                        await ReadErrorMessage(
                            sideDishResponse,
                            $"Die Beilagen für {GetDayName(day.Date)} konnten nicht gespeichert werden.");

                    return;
                }
            }

            // -------------------------------------------------
            // 3. Aktuellen Stand neu laden
            // -------------------------------------------------

            await LoadPlan();

            successMessage =
                "Die Woche wurde erfolgreich gespeichert.";
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Die Woche konnte nicht gespeichert werden: {ex.Message}";
        }
        finally
        {
            saving = false;
        }
    }


    // ---------------------------------------------------------
    // Helpers
    // ---------------------------------------------------------

    private static async Task<string> ReadErrorMessage(
        HttpResponseMessage response,
        string fallbackMessage)
    {
        try
        {
            var error =
                await response.Content
                    .ReadFromJsonAsync<ApiError>();

            if (!string.IsNullOrWhiteSpace(
                    error?.Message))
            {
                return error.Message;
            }

            var content =
                await response.Content
                    .ReadAsStringAsync();

            if (!string.IsNullOrWhiteSpace(content))
            {
                return content;
            }
        }
        catch
        {
        }

        return fallbackMessage;
    }


    private static string GetDayName(
        DateOnly date)
    {
        return date.DayOfWeek switch
        {
            DayOfWeek.Monday =>
                "Montag",

            DayOfWeek.Tuesday =>
                "Dienstag",

            DayOfWeek.Wednesday =>
                "Mittwoch",

            DayOfWeek.Thursday =>
                "Donnerstag",

            DayOfWeek.Friday =>
                "Freitag",

            DayOfWeek.Saturday =>
                "Samstag",

            DayOfWeek.Sunday =>
                "Sonntag",

            _ =>
                string.Empty
        };
    }


    // ---------------------------------------------------------
    // ViewModels / DTOs
    // ---------------------------------------------------------

    private sealed class DayViewModel
    {
        public DateOnly Date { get; set; }

        public string SelectedMealId { get; set; }
            = string.Empty;

        public HashSet<Guid> SelectedSideDishIds { get; set; }
            = new();

        public Guid? SideDishToAddId { get; set; }

        public string NewSideDishName { get; set; }
            = string.Empty;

        public bool ShowSideDishes { get; set; }
    }


    private sealed class WeeklyMealPlanDto
    {
        public Guid Id { get; set; }

        public int Year { get; set; }

        public int CalendarWeek { get; set; }

        public List<MealPlanEntryDto> Entries { get; set; }
            = new();
    }


    private sealed class MealPlanEntryDto
    {
        public Guid Id { get; set; }

        public Guid WeeklyMealPlanId { get; set; }

        public DateOnly Date { get; set; }

        public Guid MealId { get; set; }

        public MealDto Meal { get; set; }
            = new();

        public List<SideDishDto> SideDishes { get; set; }
            = new();
    }


    private sealed class MealDto
    {
        public Guid Id { get; set; }

        public string Name { get; set; }
            = string.Empty;
    }


    private sealed class SideDishDto
    {
        public Guid Id { get; set; }

        public string Name { get; set; }
            = string.Empty;
    }


    private sealed class SaveWeekRequest
    {
        public List<SaveWeekEntryRequest> Entries { get; set; }
            = new();
    }


    private sealed class SaveWeekEntryRequest
    {
        public DateOnly Date { get; set; }

        public Guid? MealId { get; set; }
    }


    private sealed class ApiError
    {
        public string Message { get; set; }
            = string.Empty;
    }
}